{"rule_id": "17ce9373-2163-4a2c-90ba-f91e9ef7a8c1", "rule_path": "data/sigma/rules-emerging-threats/2024/Exploits/CVE-2024-35250/image_load_exploit_cve_2024_35250_privilege_escalation.yml", "title": "Potential CVE-2024-35250 Exploitation Activity", "category": "image_load", "product": "windows", "urls": ["https://thehackernews.com/2024/12/cisa-and-fbi-raise-alerts-on-exploited.html", "https://devco.re/blog/2024/08/23/streaming-vulnerabilities-from-windows-kernel-proxying-to-kernel-part1-en/"], "text_chars": 34199, "config": {"arm": "baseline", "backend": "OllamaLLMClient", "primary_model": "qwen3-coder:30b", "fast_model": "qwen3-coder:30b", "economy_model": "", "web_enrich": false, "min_chars": 2000}, "run_at": "2026-09-13T22:51:42.460486+00:00", "snapshots_served": 2, "snapshots_missed": 0, "n_rules": 2, "rules_yaml": ["title: Local Privilege Escalation via MSKSSRV Kernel Driver Exploitation\nid: 5a1b3c4d-5a1b-5a1b-5a1b-5a1b3c4d5a1b\nstatus: experimental\ndescription: Detects exploitation of CVE-2024-35250 in MSKSSRV kernel streaming service via untrusted pointer dereference to escalate privileges locally. This rule targets kernel-mode exploitation patterns including IOCTL_KS_PROPERTY calls and memory manipulation functions.\nreferences:\n    - https://thehackernews.com/2024/12/cisa-and-fbi-raise-alerts-on-exploited.html\n    - https://devco.re/blog/2024/08/23/streaming-vulnerabilities-from-windows-kernel-proxying-to-kernel-part1-en/\n    - https://attack.mitre.org/techniques/T1068/\nauthor: Sigma Assistant\ndate: 2026-09-13\ntags:\n    - attack.privilege_escalation\n    - attack.t1068\nlogsource:\n    category: process_creation\n    product: windows\ndetection:\n    selection:\n        CommandLine|contains:\n            - 'IOCTL_KS_PROPERTY'\n            - 'KsOpenDefaultDevice'\n            - 'memmove'\n            - 'ExAllocatePoolWithTag'\n            - 'CheckIrpForStackAdjustmentNative'\n        Image|endswith: '\\mskssrv.exe'\n    condition: selection\nfalsepositives:\n    - Legitimate kernel-mode driver development tools\n    - System administration utilities using kernel streaming APIs\nlevel: critical", "title: Remote Initial Access via Adobe ColdFusion Vulnerability Exploitation\nid: 6b2c4d5e-6b2c-6b2c-6b2c-6b2c4d5e6b2c\nstatus: experimental\ndescription: Detects exploitation of CVE-2024-20767 in Adobe ColdFusion to gain remote access through improper access control in admin panels. This rule identifies patterns associated with remote exploitation attempts targeting internet-exposed ColdFusion applications.\nreferences:\n    - https://thehackernews.com/2024/12/cisa-and-fbi-raise-alerts-on-exploited.html\n    - https://devco.re/blog/2024/08/23/streaming-vulnerabilities-from-windows-kernel-proxying-to-kernel-part1-en/\n    - https://attack.mitre.org/techniques/T1190/\nauthor: Sigma Assistant\ndate: 2026-09-13\ntags:\n    - attack.initial_access\n    - attack.t1190\nlogsource:\n    category: process_creation\n    product: windows\ndetection:\n    selection:\n        CommandLine|contains:\n            - 'ColdFusion'\n            - 'admin\\\\'\n        Image|endswith:\n            - '\\coldfusion.exe'\n            - '\\cfusion.exe'\n    condition: selection\nfalsepositives:\n    - Legitimate ColdFusion administration activities\n    - System updates or patches for ColdFusion\nlevel: high"], "scores": {"validity": {"parses": true, "parse_error": null, "issue_count": 1, "issues_by_severity": {"error": 0, "warning": 1, "info": 0}, "issue_types": ["InvalidATTACKTagIssue"]}, "logsource": {"exact_match": false, "fields_matched": 1, "fields_scored": 2, "per_field": {"category": {"predicted": "process_creation", "gold": "image_load", "match": false, "gold_present": true}, "product": {"predicted": "windows", "gold": "windows", "match": true, "gold_present": true}, "service": {"predicted": null, "gold": null, "match": true, "gold_present": false}}}, "attack": {"exact": {"precision": 1.0, "recall": 1.0, "f1": 1.0, "n_predicted": 1, 