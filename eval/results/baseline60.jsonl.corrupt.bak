{"rule_id": "92389a99-5215-43b0-a09f-e334453b2ed3", "rule_path": "data/sigma/rules-emerging-threats/2023/Exploits/CVE-2023-36874/file_event_win_exploit_cve_2023_36874_report_creation.yml", "title": "Potential CVE-2023-36874 Exploitation - Uncommon Report.Wer Location", "category": "file_event", "product": "windows", "urls": ["https://github.com/Wh04m1001/CVE-2023-36874", "https://www.crowdstrike.com/blog/falcon-complete-zero-day-exploit-cve-2023-36874/"], "text_chars": 23321, "config": {"arm": "baseline", "backend": "OllamaLLMClient", "primary_model": "qwen3-coder:30b", "fast_model": "qwen3-coder:30b", "economy_model": "", "web_enrich": false, "min_chars": 2000}, "run_at": "2026-09-13T22:59:41.729515+00:00", "snapshots_served": 2, "snapshots_missed": 0, "n_rules": 2, "rules_yaml": ["title: Initial Access via CVE-2023-36874 SAML Out-of-Bounds Read\nid: 5a8b3c9d-4e5f-6a7b-8c9d-0e1f2a3b4c5d\nstatus: experimental\ndescription: Detects unauthenticated HTTP POST requests to /saml/login with oversized/malformed SAMLRequest body triggering out-of-bounds read vulnerability (CVE-2023-36874).\nreferences:\n    - https://github.com/Wh04m1001/CVE-2023-36874\n    - https://www.crowdstrike.com/blog/falcon-complete-zero-day-exploit-cve-2023-36874/\n    - https://attack.mitre.org/techniques/T1036/001/\n    - https://attack.mitre.org/techniques/T1027/005/\n    - https://attack.mitre.org/techniques/T1007/\n    - https://attack.mitre.org/techniques/T1562/011/\nauthor: Sigma Assistant\ndate: 2026-09-13\ntags:\n    - attack.initial-access\n    - attack.collection\n    - attack.t1036.001\n    - attack.t1027.005\n    - attack.t1007\n    - attack.t1562.011\nlogsource:\n    category: webserver_access_log\n    product: apache\n    service: httpd\ndetection:\n    selection:\n        cs-method: POST\n        cs-uri-query: /saml/login\n        request_body|contains: SAMLRequest=\n    condition: selection\nfalsepositives:\n    - Legitimate administrative tools accessing SAML endpoints\n    - Automated testing or monitoring tools\nlevel: high", "title: Memory Disclosure via CVE-2023-36874 SAML Out-of-Bounds Read\nid: 6b9c4d0e-5f6a-7b8c-9d0e-1f2a3b4c5d6e\nstatus: experimental\ndescription: Detects response headers containing NSC_TASS= which indicates memory disclosure from out-of-bounds read vulnerability (CVE-2023-36874).\nreferences:\n    - https://github.com/Wh04m1001/CVE-2023-36874\n    - https://www.crowdstrike.com/blog/falcon-complete-zero-day-exploit-cve-2023-36874/\n    - https://attack.mitre.org/techniques/T1036/001/\n    - https://attack.mitre.org/techniques/T1027/005/\n    - https://attack.mitre.org/techniques/T1007/\n    - https://attack.mitre.org/techniques/T1562/011/\nauthor: Sigma Assistant\ndate: 2026-09-13\ntags:\n    - attack.collection\n    - attack.t1036.001\n    - attack.t1027.005\n    - attack.t1007\n    - attack.t1562.011\nlogsource:\n    category: webserver_access_log\n    product: apache\n    service: httpd\ndetection:\n    selection:\n        response_header|contains: NSC_TASS=\n    condition: selection\nfalsepositives:\n    - Legitimate applications using NSC_TASS for session management\n    - Other vulnerable systems using similar session cookie naming\nlevel: high"], "scores": {"validity": {"parses": true, "parse_error": null, "issue_count": 0, "issues_by_severity": {"error": 0, "warning": 0, "info": 0}, "issue_types": []}, "logsource": {"exact_match": false, "fields_matched": 0, "fields_scored": 2, "per_field": {"category": {"predicted": "webserver_access_log", "gold": "file_event", "match": false, "gold_present": true}, "product": {"predicted": "apache", "gold": "windows", "match": false, "gold_present": true}, "service": {"predicted": "httpd", "gold": null, "match": false, "gold_present": false}}}, "attack": {"exact": {"precision": 0.0, "recall": null, "f1": null, "n_predicted": 4, "n_gold": 0, "n_overlap": 0}, "parent": {"precision": 0.0, "recall": null, "f1": null, "n_predicted": 4, "n_gold": 0, "n_overlap": 0}, "predicted": ["t1007", "t1027.005", "t1036.001", "t1562.011"], "gold": []}, "detection_fields": {"precision": 0.0, "recall": 0.0, "f1": 0.0, "n_predicted": 3, "n_gold": 1, "n_overlap": 0, "predicted_fields": ["cs-method", "cs-uri-query", "request_body"], "gold_fields": ["targetfilename"]}}, "response_chars": 3902, "error": null, "elapsed_s": 70.27, "telemetry": {"n_calls": 4, "n_errors": 0, "total_latency_s": 69.955, "prompt_tokens": 20596, "completion_tokens": 3803, "thinking_tokens": 0, "total_tokens": 24399, "calls_with_token_data": 4, "calls_without_token_data": 0, "by_tier": {"economy": {"calls": 4, "prompt_tokens": 20596, "completion_tokens": 3803, "thinking_tokens": 0, "total_tokens": 24399, "latency_s": 69.95488245799999, "errors": 0, "model": "qwen3-coder:30b"}}}, "llm_calls": [{"backend": "ollama", "tier": "economy", "model": "qwen3-coder:30b", "operation": "generate", "latency_s": 8.384521416000041, "prompt_chars": 18744, "response_chars": 1500, "prompt_tokens": 5084, "completion_tokens": 390, "thinking_tokens": null, "total_tokens": 5474, "ok": true, "error": null}, {"backend": "ollama", "tier": "economy", "model": "qwen3-coder:30b", "operation": "generate", "latency_s": 15.66161591599996, "prompt_chars": 15553, "response_chars": 3479, "prompt_tokens": 3888, "completion_tokens": 921, "thinking_tokens": null, "total_tokens": 4809, "ok": true, "error": null}, {"backend": "ollama", "tier": "economy", "model": "qwen3-coder:30b", "operation": "generate", "latency_s": 24.32249066700001, "prompt_chars": 36008, "response_chars": 3342, "prompt_tokens": 9221, "completion_tokens": 1085, "thinking_tokens": null, "total_tokens": 10306, "ok": true, "error": null}, {"backend": "ollama", "tier": "economy", "model": "qwen3-coder:30b", "operation": "generate", "latency_s": 21.586254458999974, "prompt_chars": 8858, "response_chars": 4550, "prompt_tokens": 2403, "completion_tokens": 1407, "thinking_tokens": null, "total_tokens": 3810, "ok": true, "error": null}]}
