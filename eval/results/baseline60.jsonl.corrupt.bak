{"rule_id": "bcc6f179-11cd-4111-a9a6-0fab68515cf7", "rule_path": "data/sigma/rules-emerging-threats/2023/Malware/Griffon/proc_creation_win_malware_griffon_patterns.yml", "title": "Griffon Malware Attack Pattern", "category": "process_creation", "product": "windows", "urls": ["https://securelist.com/fin7-5-the-infamous-cybercrime-rig-fin7-continues-its-activities/90703/"], "text_chars": 28214, "config": {"arm": "baseline", "backend": "OllamaLLMClient", "primary_model": "qwen3-coder:30b", "fast_model": "qwen3-coder:30b", "economy_model": "", "web_enrich": false, "min_chars": 2000}, "run_at": "2026-09-13T23:03:49.335379+00:00", "snapshots_served": 1, "snapshots_missed": 0, "n_rules": 3, "rules_yaml": ["title: Initial Access - Email-based Social Engineering with Macro-Enabled Document\nid: 5f3a8b5c-1d4e-4f5a-9b6c-7d8e9f0a1b2c\nstatus: experimental\ndescription: Detects initial access via email-based social engineering campaign delivering malicious Office documents with embedded macros, specifically looking for the presence of macro-enabled document attachment and Java deserialization magic bytes.\nreferences:\n    - https://attack.mitre.org/techniques/T1566.001/\nauthor: Sigma Assistant\ndate: 2026-09-13\ntags:\n    - attack.initial-access\n    - attack.t1566.001\nlogsource:\n    category: file_event\n    product: windows\ndetection:\n    selection:\n        TargetFilename|endswith:\n            - .docm\n            - .dotm\n            - .xlsm\n            - .xltm\n            - .potm\n            - .pptm\n    file_content:\n        - 'rO0AB'\n    condition: selection and file_content\nfalsepositives:\n    - Legitimate macro-enabled documents used in business processes\nlevel: high", "title: Execution - Office Application Macro Execution\nid: 6a7b8c9d-2e3f-4a5b-6c7d-8e9f0a1b2c3d\nstatus: experimental\ndescription: Detects execution of malicious macros within Office applications, which is a key step in the attack chain following initial access via email-based social engineering.\nreferences:\n    - https://attack.mitre.org/techniques/T1059.005/\nauthor: Sigma Assistant\ndate: 2026-09-13\ntags:\n    - attack.execution\n    - attack.t1059.005\nlogsource:\n    category: process_creation\n    product: windows\ndetection:\n    selection:\n        Image|endswith:\n            - \\winword.exe\n            - \\excel.exe\n            - \\powerpnt.exe\n            - \\msaccess.exe\n        CommandLine|contains:\n            - 'rO0AB'\n    condition: selection\nfalsepositives:\n    - Legitimate use of macros in business applications\nlevel: high", "title: Persistence - Office Macro Registry Modification\nid: 7b8c9d0e-3f4a-5b6c-7d8e-9f0a1b2c3d4e\nstatus: experimental\ndescription: Detects registry modifications related to Office macro settings that enable macro execution, which is a persistence mechanism used after initial access and execution phases.\nreferences:\n    - https://attack.mitre.org/techniques/T1137/\nauthor: Sigma Assistant\ndate: 2026-09-13\ntags:\n    - attack.persistence\n    - attack.t1137\nlogsource:\n    category: registry_set\n    product: windows\ndetection:\n    selection:\n        TargetObject|endswith: \\\\Security\\\\VBAWarnings\n        Details: DWORD (0x00000001)\n    condition: selection\nfalsepositives:\n    - Legitimate configuration changes by system administrators\nlevel: high"], "scores": {"validity": {"parses": true, "parse_error": null, "issue_count": 0, "issues_by_severity": {"error": 0, "warning": 0, "info": 0}, "issue_types": []}, "logsource": {"exact_match": false, "fields_matched": 1, "fields_scored": 2, "per_field": {"category": {"predicted": "file_event", "gold": "process_creation", "match": false, "gold_present": true}, "product": {"predicted": "windows", "gold": "windows", "match": true, "gold_present": true}, "service": {"predicted": null, "gold": null, "match": true, "gold_present": false}}}, "attack": {"exact": {"precision": 0.0, "recall": null, "f1": null, "n_predicted": 1, "n_gold": 0, "n_overlap": 0}, "parent": {"precision": 0.0, "recall": null, "f1": null, "n_predicted": 1, "n_gold": 0, "n_overlap": 0}, "predicted": ["t1566.001"], "gold": []}, "detection_fields": {"precision": 0.0, "recall": 0.0, "f1": 0.0, "n_predicted": 1, "n_gold": 1, "n_overlap": 0, "predicted_fields": ["targetfilename"], "gold_fields": ["commandline"]}}, "response_chars": 4666, "error": null, "elapsed_s": 95.35, "telemetry": {"n_calls": 6, "n_errors": 0, "total_latency_s": 94.877, "prompt_tokens": 25591, "completion_tokens": 5455, "thinking_tokens": 0, "total_tokens": 31046, "calls_with_token_data": 6, "calls_without_token_data": 0, "by_tier": {"economy": {"calls": 6, "prompt_tokens": 25591, "completion_tokens": 5455, "thinking_tokens": 0, "total_tokens": 31046, "latency_s": 94.87695866800016, "errors": 0, "model": "qwen3-coder:30b"}}}, "llm_calls": [{"backend": "ollama", "tier": "economy", "model": "qwen3-coder:30b", "operation": "generate", "latency_s": 9.64669237499993, "prompt_chars": 18744, "response_chars": 2121, "prompt_tokens": 4432, "completion_tokens": 500, "thinking_tokens": null, "total_tokens": 4932, "ok": true, "error": null}, {"backend": "ollama", "tier": "economy", "model": "qwen3-coder:30b", "operation": "generate", "latency_s": 6.938927042000046, "prompt_chars": 17482, "response_chars": 1535, "prompt_tokens": 3999, "completion_tokens": 340, "thinking_tokens": null, "total_tokens": 4339, "ok": true, "error": null}, {"backend": "ollama", "tier": "economy", "model": "qwen3-coder:30b", "operation": "generate", "latency_s": 21.582686792000004, "prompt_chars": 29264, "response_chars": 3991, "prompt_tokens": 6937, "completion_tokens": 1102, "thinking_tokens": null, "total_tokens": 8039, "ok": true, "error": null}, {"backend": "ollama", "tier": "economy", "model": "qwen3-coder:30b", "operation": "generate", "latency_s": 18.205994125000075, "prompt_chars": 6547, "response_chars": 4639, "prompt_tokens": 1642, "completion_tokens": 1235, "thinking_tokens": null, "total_token