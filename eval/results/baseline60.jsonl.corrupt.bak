{"rule_id": "1d218616-71b0-4c40-855b-9dbe75510f7f", "rule_path": "data/sigma/rules-emerging-threats/2021/Malware/Netwire/registry_add_malware_netwire.yml", "title": "Potential NetWire RAT Activity - Registry", "category": "registry_add", "product": "windows", "urls": ["https://www.fortinet.com/blog/threat-research/new-netwire-rat-variant-spread-by-phishing", "https://unit42.paloaltonetworks.com/guloader-installing-netwire-rat/"], "text_chars": 27908, "config": {"arm": "baseline", "backend": "OllamaLLMClient", "primary_model": "qwen3-coder:30b", "fast_model": "qwen3-coder:30b", "economy_model": "", "web_enrich": false, "min_chars": 2000}, "run_at": "2026-09-13T22:55:48.816505+00:00", "snapshots_served": 2, "snapshots_missed": 0, "n_rules": 7, "rules_yaml": ["title: NetWire RAT Initial Access via Phishing Email\nid: 5a8b3c7d-4e5f-6a7b-8c9d-1e2f3a4b5c6d\nstatus: experimental\ndescription: Detects initial access via phishing email containing hyperlink to NetWire RAT download link.\nreferences:\n    - https://www.fortinet.com/blog/threat-research/new-netwire-rat-variant-spread-by-phishing\n    - https://attack.mitre.org/techniques/T1598/003/\n    - https://attack.mitre.org/techniques/T1566/001/\nauthor: Sigma Assistant\ndate: 2026-09-13\ntags:\n    - attack.initial_access\n    - attack.t1566.001\nlogsource:\n    category: process_creation\n    product: windows\ndetection:\n    selection:\n        CommandLine|contains:\n            - 'hxxps[:]//www[.]mediafire[.]com/file/'\n            - 'PROFORMA-INVOICE_0990.7z'\n    condition: selection\nfalsepositives:\n    - Legitimate email containing MediaFire links\nlevel: high", "title: NetWire RAT Execution via PROFORMA-INVOICE 0990.exe\nid: 9f8e7d6c-5b4a-3c2b-1a0f-8e7d6c5b4a3c\nstatus: experimental\ndescription: Detects execution of the NetWire RAT payload named PROFORMA-INVOICE 0990.exe.\nreferences:\n    - https://www.fortinet.com/blog/threat-research/new-netwire-rat-variant-spread-by-phishing\n    - https://attack.mitre.org/techniques/T1059/001/\nauthor: Sigma Assistant\ndate: 2026-09-13\ntags:\n    - attack.execution\nlogsource:\n    category: process_creation\n    product: windows\ndetection:\n    selection:\n        Image|endswith: 'PROFORMA-INVOICE 0990.exe'\n    condition: selection\nfalsepositives:\n    - Legitimate software named PROFORMA-INVOICE 0990.exe\nlevel: high", "title: NetWire RAT C2 Communication to gbam0001.duckdns.org\nid: 1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d\nstatus: experimental\ndescription: Detects outbound network connection to the C2 server domain gbam0001.duckdns.org used by NetWire RAT.\nreferences:\n    - https://www.fortinet.com/blog/threat-research/new-netwire-rat-variant-spread-by-phishing\n    - https://attack.mitre.org/techniques/T1021/001/\nauthor: Sigma Assistant\ndate: 2026-09-13\ntags:\n    - attack.lateral_movement\nlogsource:\n    category: network_connection\n    product: windows\ndetection:\n    selection:\n        DestinationHostname|endswith: 'gbam0001.duckdns.org'\n        DestinationPort: 3366\n    condition: selection\nfalsepositives:\n    - Legitimate traffic to gbam0001.duckdns.org\nlevel: high", "title: NetWire RAT Persistence via MS Visual Basic Compilation\nid: 2b3c4d5e-6f7a-8b9c-0d1e-2f3a4b5c6d7e\nstatus: experimental\ndescription: Detects use of MS Visual Basic for compilation of NetWire RAT, indicating potential persistence mechanism.\nreferences:\n    - https://www.fortinet.com/blog/threat-research/new-netwire-rat-variant-spread-by-phishing\n    - https://attack.mitre.org/techniques/T1059/001/\nauthor: Sigma Assistant\ndate: 2026-09-13\ntags:\n    - attack.execution\nlogsource:\n    category: process_creation\n    product: windows\ndetection:\n    selection:\n        CommandLine|contains: 'MS Visual Basic'\n    condition: selection\nfalsepositives:\n    - Legitimate MS Visual Basic development\nlevel: medium", "title: NetWire RAT Anti-Analysis Techniques\nid: 3c4d5e6f-7a8b-9c0d-1e2f-3a4b5c6d7e8f\nstatus: experimental\ndescription: Detects anti-analysis techniques used by NetWire RAT such as dynamic code execution and mouse movement detection.\nreferences:\n    - https://www.fortinet.com/blog/threat-research/new-netwire-rat-variant-spread-by-phishing\n    - https://attack.mitre.org/techniques/T1082/\nauthor: Sigma Assistant\ndate: 2026-09-13\ntags:\n    - attack.discovery\nlogsource:\n    category: process_creation\n    product: windows\ndetection:\n    selection:\n        Image|endswith: 'PROFORMA-INVOICE 0990.exe'\n        CommandLine|contains:\n            - 'dynamic code extraction'\n            - 'USER32.GetCursorPos'\n            - 'ntdll.ZwGetContextThread'\n    condition: selection\nfalsepositives:\n    - Legitimate software using dynamic code extraction\nlevel: medium", "title: NetWire RAT Credential Access Activity\nid: 4d5e6f7a-8b9c-0d1e-2f3a-4b5c6d7e8f9a\nstatus: experimental\ndescription: Detects credential access attempts by NetWire RAT through anti-debugging measures and system information discovery.\nreferences:\n    - https://www.fortinet.com/blog/threat-research/new-netwire-rat-variant-spread-by-phishing\n    - https://attack.mitre.org/techniques/T1003/001/\nauthor: Sigma Assistant\ndate: 2026-09-13\ntags:\n    - attack.credential_access\nlogsource:\n    category: process_creation\n    product: windows\ndetection:\n    selection:\n        Image|endswith: 'PROFORMA-INVOICE 0990.exe'\n        CommandLine|contains:\n            - 'anti-debugging'\n            - 'system information'\n    condition: selection\nfalsepositives:\n    - Legitimate software with anti-debugging features\nlevel: medium", "title: NetWire RAT Collection Activity\nid: 5e6f7a8b-9c0d-1e2f-3a4b-5c6d7e8f9a0b\nstatus: experimental\ndescription: Detects collection activities performed by NetWire RAT, such as file and system information gathering.\nreferences:\n    - https://www.fortinet.com/blog/threat-research/new-netwire-rat-variant-spread-by-phishing\n    - https://attack.mitre.org/techniques/T1119/\nauthor: Sigma Assistant\ndate: 2026-09-13\ntags:\n    - attack.collection\nlogsource:\n    category: process_creation\n    product: windows\ndetection:\n    selection:\n        Image|endswith: 'PROFORMA-INVOICE 0990.exe'\n        CommandLine|contains:\n            - 'file collection'\n            - 'system information'\n    condition: selection\nfalsepositives:\n    - Legitimate software performing collection tasks\nlevel: medium"], "scores": {"validity": {"parses": true, "parse_error": null, "issue_count": 1, "issues_by_severity": {"error": 0, "warning": 1, "info": 0}, "issue_types": ["InvalidATTACKTagIssue"]}, "logsource": {"exact_match": false, "fields_matched": 1, "fields_scored": 2, "per_field": {"category": {"predicted": "process_creation", "gold": "registry_add", "match": false, "gold_present": true}, "product": {"predicted": "windows", "gold": "windows", "match": true, "gold_present": true}, "service": {"predicted": null, "gold": null, "match": true, "gold_present": false}}}, "attack": {"exact": {"precision": 0.0, "recall": 0.0, "f1": 0.0, "n_predicted": 1, "n_gold": 1, "n_overlap": 0}, "parent": {"precision": 0.0, "recall": 0.0, "f1": 0.0, "n_predicted": 1, "n_gold": 1, "n_overlap": 0}, "predicted": ["t1566.001"], "gold": ["t1112"]}, "detection_fields": {"precision": 0.0, "recall": 0.0, "f1": 0.0, "n_predicted": 1, "n_gold": 1, "n_overlap": 0, "predicted_fields": ["commandline"], "gold_fields": ["targetobject"]}}, "response_chars": 9002, "error": null, "elapsed_s": 232.91, "telemetry": {"n_calls": 6, "n_errors": 0, "total_latency_s": 232.413, "prompt_tokens": 39903, "completion_tokens": 12524, "thinking_tokens": 0, "total_tokens": 52427, "calls_with_token_data": 6, "calls_without_token_data": 0, "by_tier": {"economy": {"calls": 6, "prompt_tokens": 39903, "completion_tokens": 12524, "thinking_tokens": 0, "total_tokens": 52427, "latency_s": 232.41320429399997, "errors": 0, "model": "qwen3-coder:30b"}}}, "llm_calls": [{"backend": "ollama", "tier": "economy", "model": "